# 复制为 .env。请勿将真实密钥上传到 GitHub。
# 使用 HTTPS 反向代理后将 PUBLIC_HTTPS 改为 1（Secure Cookie）
PUBLIC_HTTPS=0
BIND_ADDR=0.0.0.0
PORT=5699
# 若不配置 AI_API_KEY，网站仍可正常使用，但没有内置 AI 自动回复；可部署外部 Codex 轮询智能体。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# 防滥用：内置 worker 每60秒最多处理1条，每天最多25条。重启计数清零。
AI_DAILY_LIMIT=25

# 仅开启后，AI 对“扩写章节内容”的回复会以【未人工核验草稿】追加到本章概览，不覆盖原文。
AI_AUTO_EDIT=0
