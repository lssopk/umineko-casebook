{
  "id": 1,
  "title": "黄金魔女的传说",
  "en": "Legend of the Golden Witch",
  "lead": "1986 年 10 月 4 日，右代宫家在六轩岛举行亲族会议。围绕遗产、黄金碑文与自称魔女的来信，原本的家族聚会逐渐变成封闭环境中的连续惨剧。",
  "overview": [
    "战人相隔六年返回六轩岛，与亲族重聚。家主金藏的健康、遗产与家族地位构成大人之间的核心争执。",
    "真里亚收到自称贝阿朵莉切的信件，碑文所述仪式似乎随着仓库中的惨案被逐渐重演。",
    "台风隔断外界联系，金藏消失、绘羽夫妇密室、锅炉室与客厅等事件不断发生。",
    "茶会中战人否认以魔法解释命案的方式；「????」里贝伦卡斯泰露登场，提出观察棋盘与规则的思路。"
  ],
  "events": [
    {
      "time": "10/04 上午",
      "title": "众人登岛",
      "text": "亲族抵达六轩岛，介绍金藏、碑文、魔女画像与复杂的家族关系。",
      "kind": "家族与环境"
    },
    {
      "time": "10/04 夜",
      "title": "神秘来信",
      "text": "真里亚向众人转达署名贝阿朵莉切的信，宣称围绕黄金与契约的规则。",
      "kind": "证词"
    },
    {
      "time": "10/05 早晨",
      "title": "仓库六人事件",
      "text": "藏臼、留弗夫、雾江、楼座、纱音、乡田的遗体被发现。",
      "kind": "命案"
    },
    {
      "time": "10/05 白天",
      "title": "书房与锁链密室",
      "text": "金藏的去向成为争议，绘羽和秀吉在锁链上锁的房间中遇害。",
      "kind": "密室"
    },
    {
      "time": "10/05 白天",
      "title": "锅炉室事件",
      "text": "嘉音受到攻击，另有被认为是金藏的烧焦遗体出现。",
      "kind": "命案"
    },
    {
      "time": "10/05 夜间",
      "title": "新信件与分组",
      "text": "书房中的信件加剧对立，留下不同小组。",
      "kind": "证词"
    },
    {
      "time": "10/05 夜间",
      "title": "客厅三人事件",
      "text": "源次、熊泽、南条遇害，真里亚独自在场。",
      "kind": "命案"
    },
    {
      "time": "10/05 最后",
      "title": "夏妃与四名孩子",
      "text": "夏妃中弹，孩子们面对事件尾声。",
      "kind": "命案"
    },
    {
      "time": "茶会",
      "title": "战人与魔女的争论",
      "text": "茶会从交流转变为不寻常的对峙。",
      "kind": "叙事层"
    },
    {
      "time": "????",
      "title": "棋盘的提示",
