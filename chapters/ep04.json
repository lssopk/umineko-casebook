      "kind": "线索"
    },
    {
      "time": "追寻过程",
      "title": "调查过去",
      "text": "缘寿通过记录和接触相关人员追寻六轩岛。",
      "kind": "调查"
    },
    {
      "time": "1986 棋盘",
      "title": "新一轮事件",
